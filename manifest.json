{
  "manifest_version": 3,
  "name": "Virtual Try-On Extension",
  "version": "1.0",
  "description": "AI-powered virtual dressing room extension.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "scripts/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Open AI Dressing Room"
  }
}